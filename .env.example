# NeoPedCalc — variáveis de ambiente (NUNCA grave valores reais neste arquivo).
#
# ESSENCIAIS (o servidor não inicia sem elas em produção)
#   APP_URL — origem pública HTTPS. No Railway, se ausente, usa RAILWAY_PUBLIC_DOMAIN.
#   PORT    — o Railway injeta automaticamente; padrão 8080.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_URL=http://localhost:8080
# Produção (Railway):
#   NODE_ENV=production
#   HOST=0.0.0.0
#   APP_URL=https://neopedcalc-production.up.railway.app

# INTEGRAÇÕES (opcionais para INICIAR o servidor, obrigatórias para vender)
# Se faltarem em produção: o site público funciona, mas login, checkout e as
# calculadoras protegidas ficam BLOQUEADOS (nunca liberados de graça).
# Em desenvolvimento, sem ambas, abre-se uma prévia local sem cobrança.

# Supabase (contas/autenticação)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (assinaturas) — chave sk_/rk_ e IDs price_
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Defina a quantidade real de proxies confiáveis na hospedagem (Railway: 1).
# TRUST_PROXY=1

# Sem credenciais, npm run dev abre somente uma prévia LOCAL sem autenticação/cobrança.
# Em produção todas as variáveis abaixo são obrigatórias; o servidor falha se faltarem.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Defina a quantidade real de proxies confiáveis na hospedagem (ex.: 1).
# TRUST_PROXY=1
